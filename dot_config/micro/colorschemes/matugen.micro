color-link default "#26181a"
color-link comment "#877275"
color-link selection "#ffffff,#bc004e"
color-link hlsearch "#82524c"

color-link identifier "#bc004e"
color-link identifier.class "#bc004e"
color-link identifier.var "#bc004e"

color-link constant "#8a4f34"
color-link constant.number "#8a4f34"
color-link constant.string "#82524c"

color-link symbol "#8a4f34"
color-link symbol.brackets "#544245"
color-link symbol.tag "#bc004e"

color-link type "#bc004e"
color-link type.keyword "#82524c"

color-link special "#8a4f34"
color-link statement "#82524c"
color-link preproc "#8a4f34"

color-link underlined "#82524c"
color-link error "bold #ba1a1a"
color-link todo "bold #8a4f34"

color-link diff-added "#82524c"
color-link diff-modified "#8a4f34"
color-link diff-deleted "#ba1a1a"

color-link gutter-error "#ba1a1a"
color-link gutter-warning "#8a4f34"

color-link scrollbar "#544245"
color-link statusline "#26181a,#fff8f7"
color-link tabbar "#26181a,#fff8f7"
color-link indent-char "#f7dcdf"
color-link line-number "#dac0c3"
color-link current-line-number "#bc004e"

color-link cursor-line "#f7dcdf,#26181a"
color-link color-column "#f7dcdf"
color-link type.extended "default"
