color-link default "#25181d"
color-link comment "#857278"
color-link selection "#ffffff,#b70073"
color-link hlsearch "#7f525b"

color-link identifier "#b70073"
color-link identifier.class "#b70073"
color-link identifier.var "#b70073"

color-link constant "#8b4c4c"
color-link constant.number "#8b4c4c"
color-link constant.string "#7f525b"

color-link symbol "#8b4c4c"
color-link symbol.brackets "#534248"
color-link symbol.tag "#b70073"

color-link type "#b70073"
color-link type.keyword "#7f525b"

color-link special "#8b4c4c"
color-link statement "#7f525b"
color-link preproc "#8b4c4c"

color-link underlined "#7f525b"
color-link error "bold #ba1a1a"
color-link todo "bold #8b4c4c"

color-link diff-added "#7f525b"
color-link diff-modified "#8b4c4c"
color-link diff-deleted "#ba1a1a"

color-link gutter-error "#ba1a1a"
color-link gutter-warning "#8b4c4c"

color-link scrollbar "#534248"
color-link statusline "#25181d,#fff8f8"
color-link tabbar "#25181d,#fff8f8"
color-link indent-char "#f5dce4"
color-link line-number "#d8c1c8"
color-link current-line-number "#b70073"

color-link cursor-line "#f5dce4,#25181d"
color-link color-column "#f5dce4"
color-link type.extended "default"
